{
    "name": "draftscripts",
    "version": "1.0.0",
    "description": "This is a full stack application with react, vue and node",
    "packageManager": "pnpm@10.11.0",
    "scripts": {
        "dev": "turbo dev",
        "lint": "turbo lint",
        "build": "turbo build",
        "format": "prettier --write \"**/*.{js,jsx,css,ts,tsx}\"",
        "saas": "turbo dev --filter=saas",
        "showcase": "turbo dev --filter=showcase",
        "portfolio": "turbo dev --filter=portfolio"
    },
    "keywords": [
        "react",
        "vue",
        "fullstack",
        "typescript",
        "javascript",
        "nextjs",
        "tailwindcss",
        "express",
        "mongodb",
        "postgresql"
    ],
    "author": "Kamruzzaman",
    "license": "MIT",
    "devDependencies": {
        "@repo/eslint-config": "workspace:*",
        "@repo/typescript-config": "workspace:*",
        "prettier": "^3.6.2",
        "prettier-plugin-tailwindcss": "^0.6.14",
        "turbo": "^2.5.8",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "lucide-react": "^0.539.0"
    },
    "pnpm": {
        "overrides": {
            "@types/react": "19.2.17",
            "@types/react-dom": "19.2.3"
        }
    },
    "prettier": {
        "$schema": "https://json.schemastore.org/prettierrc",
        "semi": true,
        "tabWidth": 4,
        "singleQuote": true,
        "printWidth": 100,
        "trailingComma": "none",
        "bracketSameLine": true,
        "endOfLine": "crlf",
        "vueIndentScriptAndStyle": true,
        "plugins": [
            "prettier-plugin-tailwindcss"
        ]
    }
}
